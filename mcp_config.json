{
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "sse",
      "url": "https://mcp.exa.ai/mcp",
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    }
  }
}